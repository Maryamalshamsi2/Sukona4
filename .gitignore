# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files — covers both canonical forms (.env.local,
# .env.production.local) and editor backup variants like
# .env.local.save (nano), .env.local~ (vim/emacs), .env.local.bak.
.env*.local
.env.local*

# typescript
*.tsbuildinfo
next-env.d.ts

# Browser "Save Page As" dumps of the deployed site — occasionally
# end up in the working tree during design reviews.
Sukona_files/

# Historical-import Excel files. The template is regenerated by
# `npm run import:template` and salons' filled-in files are private
# customer data — neither belong in git.
/sukona-import-template.xlsx
/*-filled.xlsx
/import/
